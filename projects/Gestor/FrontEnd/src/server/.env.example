# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT Secret (OBRIGATÓRIO - gere uma chave forte e única)
JWT_SECRET=sua_chave_jwt_aqui

# Horse API
HORSE_API_BASE_URL=http://localhost:3002
HORSE_JWT_SECRET=coloque_aqui_o_secret_do_horse

# Relatorio IA - provedor de IA compativel com a API da OpenAI
# (OpenAI, Groq, DeepSeek, Azure OpenAI ou local: LM Studio / Ollama)
# A chave fica SOMENTE no servidor - nunca chega ao browser.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_QUOTA_DIARIA=20
LLM_TIMEOUT_MS=60000
